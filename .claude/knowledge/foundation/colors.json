{
  "name": "Colors",
  "description": "Système de couleurs sémantique à 12 steps (échelle Radix UI) à lier aux fills via setBoundVariableForPaint. Chaque famille couvre tous les usages d'un composant (fond → bordure → solide → texte). Les valeurs réelles (Theme, Light/Dark) sont résolues automatiquement par le token — ne pas les régler à la main.",
  "model": {
    "structure": "Palette/{Family}/{1-12 - Role}",
    "scale12": {
      "1":  { "role": "Background",       "use": "Fond d'application / page" },
      "2":  { "role": "Bg Subtle",        "use": "Fond de surface subtile (cards, sections)" },
      "3":  { "role": "Default Element",  "use": "Fond d'élément interactif au repos (input, ghost button)" },
      "4":  { "role": "Hovered Element",  "use": "Fond d'élément au survol" },
      "5":  { "role": "Active Element",   "use": "Fond d'élément actif / pressé / sélectionné" },
      "6":  { "role": "Subtle Border",    "use": "Bordure subtile, séparateurs" },
      "7":  { "role": "Default Border",   "use": "Bordure par défaut des éléments interactifs" },
      "8":  { "role": "Hovered Border",   "use": "Bordure au survol, focus ring faible" },
      "9":  { "role": "Solid",            "use": "Fond solide saturé (boutons primaires, badges). Couleur signature de la famille." },
      "10": { "role": "Hovered Solid",    "use": "Fond solide au survol" },
      "11": { "role": "Text Low",         "use": "Texte secondaire, low-contrast accessible" },
      "12": { "role": "Text High",        "use": "Texte principal high-contrast" }
    },
    "radixGuidance": "Steps 1-2 = fonds, 3-5 = composants, 6-8 = bordures, 9-10 = solides, 11-12 = textes. Le step 9 a le meilleur contraste pour un fond solide avec texte blanc."
  },
  "families": {
    "Default": { "intent": "Neutre / gris — surfaces, textes, bordures par défaut" },
    "Brand":   { "intent": "Action principale, accent de marque, éléments mis en avant" },
    "Error":   { "intent": "Erreurs, états invalides, actions destructrices" },
    "Success": { "intent": "Validation, confirmation, état positif" },
    "Warning": { "intent": "Avertissement, attention requise" },
    "Info":    { "intent": "Information neutre, messages informatifs" },
    "Link":    { "intent": "Liens hypertexte, navigation textuelle" }
  },
  "scopes": {
    "background (1-5, 9-10)": ["FRAME_FILL", "SHAPE_FILL"],
    "border (6-8)": ["SHAPE_FILL", "STROKE_COLOR", "EFFECT_COLOR"],
    "text (11-12)": ["SHAPE_FILL", "TEXT_FILL"]
  },
  "doAndDont": {
    "do": [
      "Lier les fills aux tokens Palette/* via setBoundVariableForPaint.",
      "Utiliser le step adapté au rôle : 9 pour un bouton solide, 11/12 pour du texte, 6/7 pour une bordure.",
      "Garder une seule famille par intention sémantique dans un même composant.",
      "Compter sur le token pour l'inversion Light/Dark automatique — ne pas dupliquer les couleurs.",
      "Appliquer les tokens à TOUS les nœuds qui ont un fill : frame principal, frames enfants, conteneurs de sections, cartes, backgrounds internes."
    ],
    "dont": [
      "Ne jamais hardcoder un hex — toujours passer par le token (ex. Brand/9). Cela vaut même pour #FFFFFF ou #000000.",
      "Ne jamais référencer une primitive masquée directement — uniquement les tokens Palette/*.",
      "Ne pas utiliser Brand pour signaler une erreur (utiliser Error).",
      "Ne pas mélanger step de texte (11/12) comme fond solide ou inversement.",
      "Ne pas laisser un fill #FFFFFF sur un frame interne sous prétexte que le frame parent a déjà le bon background — chaque frame avec un fill doit utiliser un token (ex. Default/1 pour fond page, Default/2 pour une surface/card)."
    ]
  },
